# Public — safe to expose in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — NEVER prefix with NEXT_PUBLIC_, never sent to the browser.
# Used by the teacher import script and the WhatsApp webhook route.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OPEN TESTING MODE — off unless set. Teachers sign in by typing their
# name and password (starting password set by
# supabase/seed/teachers_2026_2027.sql).
#
# OPEN_ACCESS=true skips login entirely: every page is served with the
# service-role key, there is no row-level security, and anyone with the
# URL can see and edit every school's data. Only for trying out the UI
# before real student data goes in.
# OPEN_ACCESS=true

# WhatsApp integration (see docs/WHATSAPP_INTEGRATION.md). Fill these in
# once you've created a Meta WhatsApp Cloud API app + phone number.
WHATSAPP_VERIFY_TOKEN=choose-a-random-string-you-also-paste-into-the-meta-dashboard
WHATSAPP_APP_SECRET=from-meta-app-dashboard-used-to-verify-webhook-signatures
WHATSAPP_ACCESS_TOKEN=from-meta-app-dashboard-system-user-token
WHATSAPP_PHONE_NUMBER_ID=from-meta-whatsapp-manager
