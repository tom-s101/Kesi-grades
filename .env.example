# Public — safe to expose in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — NEVER prefix with NEXT_PUBLIC_, never sent to the browser.
# Used by the teacher import script and the WhatsApp webhook route.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# TESTING ONLY. When "true", the whole app skips login and every page
# is served with the service-role key — no auth, no row-level security,
# anyone with the URL sees and can edit every school's data. Fine for
# clicking through the UI before real students are in the system. Set
# back to "false" (or delete the line) the moment real student data goes
# in, and definitely before sharing the URL outside your team.
DISABLE_AUTH=false

# WhatsApp integration (see docs/WHATSAPP_INTEGRATION.md). Fill these in
# once you've created a Meta WhatsApp Cloud API app + phone number.
WHATSAPP_VERIFY_TOKEN=choose-a-random-string-you-also-paste-into-the-meta-dashboard
WHATSAPP_APP_SECRET=from-meta-app-dashboard-used-to-verify-webhook-signatures
WHATSAPP_ACCESS_TOKEN=from-meta-app-dashboard-system-user-token
WHATSAPP_PHONE_NUMBER_ID=from-meta-whatsapp-manager
